<Window x:Class="AMon.App.DashboardWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A-mon"
        Width="900"
        Height="820"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
  <Window.Resources>
    <Style x:Key="TopNavigationButtonStyle"
           TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4">
              <Grid>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <Border x:Name="SelectionIndicator"
                        Width="18"
                        Height="3"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome"
                        Property="Background"
                        Value="{StaticResource SurfaceHoverBrush}" />
              </Trigger>
              <Trigger Property="Tag" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="SelectionIndicator"
                        Property="Visibility"
                        Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="UsageProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="3" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="SessionCardTemplate">
      <Border Margin="0,0,0,10"
              Padding="16"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Cursor="Hand"
              ToolTip="클릭하여 세션 상세 및 분석 보기">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick"
                        Command="{Binding DataContext.Sessions.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Padding="8,3"
                    Background="#2F2B4C"
                    CornerRadius="4">
              <TextBlock Foreground="#B9AFFF"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="{Binding Provider}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0">
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="{Binding Project}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="{StaticResource MutedBrush}"
                         Text="{Binding Task}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
              <TextBlock HorizontalAlignment="Right"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding Tokens}" />
              <TextBlock HorizontalAlignment="Right"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="11"
                         Text="{Binding Status}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="입력 " />
              <TextBlock Text="{Binding Input}" />
              <TextBlock Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="출력 " />
              <TextBlock Text="{Binding Output}" />
              <TextBlock Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="캐시 " />
              <TextBlock Text="{Binding Cache}" />
              <TextBlock Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Model}" />
              <TextBlock Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Agents}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Text="{Binding Time}" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="12,8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontFamily="{StaticResource DisplayFont}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Text="A-mon" />
          <TextBlock Foreground="{StaticResource MutedBrush}"
                     FontSize="10"
                     Text="AI usage monitor" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Margin="22,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
          <Button Margin="0,0,4,0"
                  Command="{Binding ShowDashboardCommand}"
                  Content="대시보드"
                  Style="{StaticResource TopNavigationButtonStyle}"
                  Tag="{Binding IsDashboardVisible}" />
          <Button Margin="0,0,4,0"
                  Command="{Binding ShowSessionsCommand}"
                  Content="세션"
                  Style="{StaticResource TopNavigationButtonStyle}"
                  Tag="{Binding IsSessionsVisible}" />
          <Button Command="{Binding ShowSettingsCommand}"
                  Content="설정"
                  Style="{StaticResource TopNavigationButtonStyle}"
                  Tag="{Binding IsSettingsVisible}" />
        </StackPanel>
        <Button Grid.Column="2"
                Width="36"
                Height="36"
                Padding="0"
                AutomationProperties.Name="사용량 새로 고침"
                Command="{Binding Settings.RefreshNowCommand}"
                Content="↻"
                FontSize="18"
                Style="{StaticResource OutlineButtonStyle}"
                ToolTip="지금 다시 스캔" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDashboardVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontFamily="{StaticResource DisplayFont}"
                     FontSize="27"
                     FontWeight="SemiBold"
                     Text="사용량" />
          <TextBlock Margin="0,3,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12"
                     Text="{Binding Dashboard.StatusText}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="10,5"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceStrongBrush}"
                CornerRadius="4">
          <TextBlock Foreground="{StaticResource MutedBrush}"
                     FontSize="11"
                     Text="10분마다 갱신" />
        </Border>
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource DashboardCardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Text="전체 사용량" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Text="{Binding Dashboard.TotalTokens}" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Text="수집된 전체 토큰" />
              </StackPanel>
              <Border Grid.Column="1"
                      MinWidth="145"
                      Padding="14,10"
                      VerticalAlignment="Center"
                      Background="{StaticResource SurfaceStrongBrush}"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock Foreground="{StaticResource MutedBrush}"
                             FontSize="11"
                             Text="오늘" />
                  <TextBlock Margin="0,3,0,0"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Text="{Binding Dashboard.TodayTokens}" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Grid Margin="2,4,2,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="플랜 잔여량" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Text="남은 비율 · 리셋까지" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Dashboard.ProviderQuotas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource DashboardCardStyle}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding Provider}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="{Binding Plan}" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              Padding="9,4"
                              VerticalAlignment="Top"
                              Background="{StaticResource SurfaceStrongBrush}"
                              CornerRadius="4">
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Text="{Binding Status}" />
                      </Border>
                    </Grid>
                    <ItemsControl Margin="0,15,0,0" ItemsSource="{Binding Metrics}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,13">
                            <Grid Margin="0,0,0,7">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Medium"
                                           Text="{Binding Label}" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           Text="{Binding ResetText}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource TextBrush}"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="{Binding RemainingText}" />
                            </Grid>
                            <ProgressBar Maximum="100"
                                         Style="{StaticResource UsageProgressBarStyle}"
                                         Value="{Binding RemainingPercent}"
                                         />
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Text="{Binding UsedText}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Margin="2,8,2,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="현재 세션" />
            <TextBlock Grid.Column="1"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Text="{Binding Sessions.StatusText}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Sessions.ActiveSessions}"
                        ItemTemplate="{StaticResource SessionCardTemplate}" />

          <TextBlock Margin="2,10,0,10"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="로컬 사용량" />
          <ItemsControl ItemsSource="{Binding Dashboard.Tools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource DashboardCardStyle}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="{Binding LastActivity}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding Total}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Text="{Binding Today, StringFormat=오늘 {0}}" />
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="입력" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Input}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="출력" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Output}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="캐시" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Cache}" />
                      </StackPanel>
                      <StackPanel Grid.Column="3">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="세션" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Sessions}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Text="{Binding Models}"
                               TextWrapping="Wrap" />
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding RecentDays}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,6,5" Padding="7,4"
                                  Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding Date}" />
                              <TextBlock Margin="6,0,0,0" FontSize="10" Text="{Binding Tokens}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Text="{Binding Note}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSessionsVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock FontFamily="{StaticResource DisplayFont}"
                   FontSize="27"
                   FontWeight="SemiBold"
                   Text="세션" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Bottom"
                   Foreground="{StaticResource MutedBrush}"
                   Text="{Binding Sessions.StatusText}" />
      </Grid>
      <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Sessions.IsDetailVisible}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <StackPanel>
          <TextBlock Margin="2,0,0,10"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Text="진행 중" />
          <ItemsControl ItemsSource="{Binding Sessions.ActiveSessions}"
                        ItemTemplate="{StaticResource SessionCardTemplate}" />
          <TextBlock Margin="2,16,0,10"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Text="최근 종료된 세션" />
          <ItemsControl ItemsSource="{Binding Sessions.CompletedSessions}"
                        ItemTemplate="{StaticResource SessionCardTemplate}" />
          <TextBlock Margin="2,8,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     Text="종료된 세션은 이 PC에 최대 200개까지 저장됩니다." />
          </StackPanel>
        </ScrollViewer>

        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Sessions.IsDetailVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Button HorizontalAlignment="Left"
                  Padding="16,8"
                  Command="{Binding Sessions.CloseSessionCommand}"
                  Content="← 세션 목록"
                  Style="{StaticResource OutlineButtonStyle}" />
          <Border Grid.Row="1"
                  Margin="0,14,0,14"
                  Padding="20"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontSize="22"
                           FontFamily="{StaticResource DisplayFont}"
                           FontWeight="Light"
                           Text="{Binding Sessions.SelectedSession.Project}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding Sessions.SelectedSession.Task}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding Sessions.AnalysisSummary}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <TextBlock HorizontalAlignment="Right"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="{Binding Sessions.SelectedSession.Tokens}" />
                <TextBlock Margin="0,5,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding Sessions.DetailStatus}" />
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Margin="0,0,0,14"
                      Padding="18"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock FontSize="18" FontWeight="Medium" Text="정적 분석" />
                  <TextBlock Margin="0,5,0,12"
                             Foreground="{StaticResource MutedBrush}"
                             Text="{Binding Sessions.AuditSummary}" />
                  <ItemsControl ItemsSource="{Binding Sessions.Findings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="10"
                                Background="#FFF1F2"
                                CornerRadius="4">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Foreground="{StaticResource ErrorBrush}"
                                         FontWeight="SemiBold"
                                         Text="{Binding Severity}" />
                              <TextBlock Margin="8,0,0,0"
                                         FontWeight="Medium"
                                         Text="{Binding Title}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11"
                                       Text="{Binding Evidence}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Expander Margin="0,8,0,0" Header="쉘 요청">
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sessions.ShellCommands}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Margin="0,0,0,6"
                                     Padding="10"
                                     Background="{StaticResource SurfaceStrongBrush}"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"
                                     Text="{Binding}"
                                     TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                  <Expander Margin="0,8,0,0" Header="파일 읽기/쓰기">
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sessions.FileAccesses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12"
                                       Text="{Binding Path}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding Summary}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
              </Border>
              <TextBlock Margin="2,0,0,10"
                         FontSize="18"
                         FontWeight="Medium"
                         Text="대화 상세" />
              <ItemsControl ItemsSource="{Binding Sessions.Transcript}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10"
                          Padding="16"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Border Padding="8,3"
                                  Background="{StaticResource SurfaceStrongBrush}"
                                  CornerRadius="4">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="{Binding Role}" />
                          </Border>
                          <TextBlock Margin="10,3,0,0"
                                     Foreground="{StaticResource MutedBrush}"
                                     Text="{Binding Model}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Time}" />
                          <TextBlock Margin="10,0,0,0"
                                     Foreground="{StaticResource MutedBrush}"
                                     Text="{Binding UsageText}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Margin="0,12,0,0"
                                 LineHeight="22"
                                 Text="{Binding Text}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock FontFamily="{StaticResource DisplayFont}"
                   FontSize="27"
                   FontWeight="SemiBold"
                   Text="설정" />
        <TextBlock Margin="0,5,0,0"
                   Foreground="{StaticResource MutedBrush}"
                   Text="로컬 데이터, 화면 동작, 서버 전송을 한곳에서 관리합니다." />
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Margin="0,0,0,14" Padding="24"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="Medium" Text="기본 설정" />
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="로그인 시 자동 실행" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="Windows에 로그인하면 A-mon을 자동으로 시작합니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.LaunchAtLoginEnabled, Mode=TwoWay}" />
              </Grid>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="자동 업데이트" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="새 버전을 자동으로 내려받아 설치합니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.AutoUpdateEnabled, Mode=TwoWay}" />
              </Grid>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="데스크톱 펫" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="현재 AI 활동을 데스크톱 위 캐릭터로 표시합니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.PetEnabled, Mode=TwoWay}" />
              </Grid>
              <Border Margin="0,18,0,0"
                      Padding="16"
                      Background="{StaticResource SurfaceStrongBrush}"
                      CornerRadius="8">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock FontSize="16" FontWeight="Medium"
                                 Text="Codex 호환 펫" />
                      <TextBlock Margin="0,4,16,0"
                                 Foreground="{StaticResource MutedBrush}"
                                 Text="Codex Pet V1(1536×1872)과 V2(1536×2288) ZIP·투명 PNG·WebP를 가져옵니다. ZIP은 pet.json의 버전을 자동 적용합니다."
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding Settings.PetSpriteVersions}"
                              SelectedItem="{Binding Settings.PetSpriteVersion, Mode=TwoWay}"
                              ToolTip="Codex 스프라이트 메타데이터 버전" />
                  </Grid>
                  <TextBox Margin="0,14,0,0"
                           IsReadOnly="True"
                           Text="{Binding Settings.PetSpritePath}"
                           ToolTip="A-mon에 설치된 로컬 스프라이트시트 경로" />
                  <WrapPanel Margin="0,12,0,0">
                    <Button Margin="0,0,8,8"
                            Click="OnImportCodexPetClick"
                            Content="펫 가져오기"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Margin="0,0,8,8"
                            Click="OnResetCodexPetClick"
                            Content="기본 펫"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Margin="0,0,8,8"
                            Click="OnOpenCodexPetGalleryClick"
                            Content="Codex 펫 다운로드"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Margin="0,0,0,8"
                            Click="OnOpenCodexPetSettingsClick"
                            Content="Codex 펫 설정"
                            Style="{StaticResource OutlineButtonStyle}" />
                  </WrapPanel>
                  <TextBlock Margin="0,4,0,0"
                             Text="{Binding Settings.PetImportStatus}"
                             TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Settings.PetImportFailed}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="로컬 현재 활동" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="Claude Code, Codex, Cursor의 진행 중인 세션을 이 PC에서만 읽습니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.LocalActivityEnabled, Mode=TwoWay}" />
              </Grid>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="현재 작업 문구 표시" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="펫과 세션 카드에 현재 작업 요약을 표시합니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.ShowsCurrentTask, Mode=TwoWay}" />
              </Grid>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="할당량 부족 알림" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="프로바이더 잔여량이 10% 이하가 되면 Windows 알림을 표시합니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.QuotaAlertsEnabled, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="0,0,0,14" Padding="24"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="Medium" Text="트레이 할당량" />
              <TextBlock Margin="0,5,0,18" Foreground="{StaticResource MutedBrush}"
                         Text="작업 표시줄 A-mon 아이콘에 선택한 프로바이더의 할당량을 표시합니다." />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Medium"
                           Text="할당량 표시" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.TrayQuotaEnabled, Mode=TwoWay}" />
              </Grid>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="프로바이더" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Settings.TrayQuotaProviders}"
                          SelectedItem="{Binding Settings.SelectedTrayQuotaProvider, Mode=TwoWay}" />
              </Grid>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="Medium" Text="잔여량으로 표시" />
                  <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                             Text="끄면 남은 양 대신 사용한 비율을 표시합니다." />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding Settings.TrayQuotaShowsRemaining, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="0,0,0,14" Padding="24"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="Medium" Text="로컬 로그 경로" />
              <TextBlock Margin="0,5,0,18" Foreground="{StaticResource MutedBrush}"
                         Text="비워 두면 각 도구의 기본 경로를 사용합니다." />
              <TextBlock Margin="0,0,0,5" Text="Claude Code" />
              <TextBox Text="{Binding Settings.ClaudePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <TextBlock Margin="0,14,0,5" Text="Codex" />
              <TextBox Text="{Binding Settings.CodexPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <TextBlock Margin="0,14,0,5" Text="Cursor" />
              <TextBox Text="{Binding Settings.CursorPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Expander Margin="0,16,0,0" Header="다른 프로바이더 경로">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Margin="0,0,0,5" Text="OpenCode" />
                  <TextBox Text="{Binding Settings.OpenCodePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Margin="0,14,0,5" Text="Gemini" />
                  <TextBox Text="{Binding Settings.GeminiPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Margin="0,14,0,5" Text="Qwen" />
                  <TextBox Text="{Binding Settings.QwenPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Margin="0,14,0,5" Text="GitHub Copilot" />
                  <TextBox Text="{Binding Settings.CopilotPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Expander>
              <Button Margin="0,18,0,0"
                      HorizontalAlignment="Right"
                      Command="{Binding Settings.RefreshNowCommand}"
                      Content="경로 적용 및 다시 스캔"
                      Style="{StaticResource OutlineButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,0,0,14" Padding="24"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="Medium" Text="서버 전송" />
              <TextBlock Margin="0,5,0,18" Foreground="{StaticResource MutedBrush}"
                         Text="일자·도구·모델별 집계 토큰만 전송합니다. 세션 내용, 프롬프트, 응답, 프로젝트 경로는 전송하지 않습니다."
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,0,0,5" Text="서버 URL" />
              <TextBox Text="{Binding Settings.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,14,0,5" Text="유저 키" />
              <TextBox Text="{Binding Settings.UserKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="{Binding Settings.ReportStatus}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Margin="16,0,0,0"
                        Command="{Binding Settings.SendNowCommand}"
                        Content="지금 전송"
                        Style="{StaticResource PrimaryButtonStyle}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
