<Window x:Class="AMon.App.DashboardWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="A-mon"
        Width="840"
        Height="580"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Padding="14"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="14">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Margin="8,6,8,22"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Text="A-mon" />
          <Button Margin="0,0,0,6"
                  AutomationProperties.Name="대시보드 화면 열기"
                  Command="{Binding ShowDashboardCommand}"
                  Content="대시보드"
                  Style="{StaticResource NavigationButtonStyle}" />
          <Button AutomationProperties.Name="설정 화면 열기"
                  Command="{Binding ShowSettingsCommand}"
                  Content="설정"
                  Style="{StaticResource NavigationButtonStyle}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,14,0,6"
                    DataContext="{Binding PetViewModel, ElementName=RootWindow}"
                    Visibility="{Binding HasRunningCarousel, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Margin="8,0,8,5"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="11"
                     Text="실행 중 세션" />
          <TextBlock Margin="8,0,8,7"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{Binding AccessiblePositionText}"
                     FontSize="12"
                     Text="{Binding CounterText}" />
          <Button Margin="0,0,0,4"
                  AutomationProperties.Name="이전 동시 세션"
                  Command="{Binding PreviousCommand}"
                  Content="이전(_P)"
                  Style="{StaticResource NavigationButtonStyle}"
                  ToolTip="이전 세션 (Alt+P)" />
          <Button AutomationProperties.Name="다음 동시 세션"
                  Command="{Binding NextCommand}"
                  Content="다음(_N)"
                  Style="{StaticResource NavigationButtonStyle}"
                  ToolTip="다음 세션 (Alt+N)" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="8"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Text="Windows Preview" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDashboardVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="{Binding Dashboard.Title}" />
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock HorizontalAlignment="Right"
                     Foreground="{StaticResource MutedBrush}"
                     Text="{Binding Dashboard.StatusText}" />
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14">
              <StackPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="전체 토큰" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Text="{Binding Dashboard.TotalTokens}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14">
              <StackPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="오늘 토큰" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Text="{Binding Dashboard.TodayTokens}" />
              </StackPanel>
            </Border>
          </Grid>

          <ItemsControl ItemsSource="{Binding Dashboard.Tools}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="292"
                        Margin="0,0,12,12"
                        Padding="18"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14">
                  <StackPanel>
                    <Grid>
                      <TextBlock FontSize="17"
                                 FontWeight="SemiBold"
                                 Text="{Binding Name}" />
                      <TextBlock HorizontalAlignment="Right"
                                 Foreground="{StaticResource MutedBrush}"
                                 Text="{Binding Sessions, StringFormat={}{0} 세션}" />
                    </Grid>
                    <TextBlock Margin="0,13,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="{Binding Total}" />
                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               Text="{Binding Today, StringFormat=오늘 {0}}" />
                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="입력" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Input}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="출력" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Output}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="캐시" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Cache}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Text="{Binding Note}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Column="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock FontSize="28"
                 FontWeight="SemiBold"
                 Text="설정" />
      <Border Grid.Row="2"
              Padding="24"
              Background="{StaticResource SurfaceBrush}"
              CornerRadius="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="자동 업데이트" />
            <TextBlock Width="470"
                       Margin="0,6,20,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="새 버전이 준비되면 자동으로 내려받아 설치합니다. 변경 내용은 즉시 저장됩니다."
                       TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="자동 업데이트 사용 여부를 즉시 저장합니다"
                    AutomationProperties.Name="자동 업데이트"
                    IsChecked="{Binding Settings.AutoUpdateEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="자동 업데이트 사용" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
