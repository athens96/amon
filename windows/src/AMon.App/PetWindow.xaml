<Window x:Class="AMon.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AMon.App"
        Width="530"
        Height="320"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Topmost="True"
        WindowStyle="None">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    <Style x:Key="PetCarouselButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PetBubbleTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource PetBubbleSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PetBubbleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome"
                        Property="BorderBrush"
                        Value="{DynamicResource PetBubbleAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TransparentPetButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="166" />
    </Grid.ColumnDefinitions>
    <Border x:Name="ActivityBubble"
            Width="340"
            Height="240"
            Margin="8"
            Padding="16,15"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding AccessibilityDescription}"
            Background="{DynamicResource PetBubbleBrush}"
            BorderBrush="{DynamicResource PetBubbleBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Cursor="Hand"
            MouseLeftButtonUp="OnBubbleClick"
            ToolTip="{Binding BubbleToolTip}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16"
                          Direction="270"
                          Opacity="0.16"
                          ShadowDepth="3" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Border Width="24"
                    Height="24"
                    Margin="0,0,9,0"
                    Background="{DynamicResource PetBubbleAccentBrush}"
                    CornerRadius="4">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentTextBrush}"
                         FontSize="10"
                         FontWeight="Bold"
                         Text="A" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Foreground="{DynamicResource PetBubbleTextBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="{Binding Current.Provider}" />
              <TextBlock Foreground="{DynamicResource PetBubbleMutedBrush}"
                         FontSize="9"
                         Text="실시간 세션" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Margin="0,0,6,0"
                    AutomationProperties.Name="지난 턴 보기"
                    Command="{Binding ToggleHistoryCommand}"
                    Content="≡"
                    PreviewMouseLeftButtonUp="OnHistoryToggleClick"
                    Style="{StaticResource PetCarouselButtonStyle}"
                    ToolTip="이 세션의 지난 턴"
                    Visibility="{Binding HasHistorySource, Converter={StaticResource BooleanToVisibility}}" />
            <Border Padding="9,4"
                    Background="{DynamicResource PetBubbleSubtleBrush}"
                    CornerRadius="4">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6"
                         Height="6"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource PetBubbleAccentBrush}" />
                <TextBlock Foreground="{DynamicResource PetBubbleMutedBrush}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Text="{Binding Current.StatusText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   AutomationProperties.Name="현재 작업"
                   Foreground="{DynamicResource PetBubbleTextBrush}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Text="{Binding TaskText}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding ShowsCurrentTask, Converter={StaticResource BooleanToVisibility}}" />

        <!-- 지난 턴 스택 — 열리면 현재 입력/출력 대신 이 세션의 최근 턴 카드가 보인다. -->
        <ScrollViewer Grid.Row="2"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowsHistory, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock Margin="0,0,0,6"
                       Foreground="{DynamicResource PetBubbleMutedBrush}"
                       FontSize="9"
                       FontWeight="Bold"
                       Text="{Binding HistoryStatusText}" />
            <ItemsControl ItemsSource="{Binding HistoryTurns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8"
                          Padding="11,9"
                          Background="{DynamicResource PetBubbleSubtleBrush}"
                          CornerRadius="6">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource PetBubbleAccentBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Text="{Binding StatusText}" />
                        <TextBlock Grid.Column="1"
                                   Foreground="{DynamicResource PetBubbleMutedBrush}"
                                   FontSize="9"
                                   Text="{Binding Time}" />
                      </Grid>
                      <TextBlock Margin="0,5,0,0"
                                 Foreground="{DynamicResource PetBubbleTextBrush}"
                                 FontSize="12"
                                 Text="{Binding Prompt}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,3,0,0"
                                 Foreground="{DynamicResource PetBubbleTextBrush}"
                                 FontSize="11"
                                 Text="{Binding Reply}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,4,0,0"
                                 Foreground="{DynamicResource PetBubbleMutedBrush}"
                                 FontSize="9"
                                 Text="{Binding TokenText}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowsHistory, Converter={StaticResource InverseBooleanToVisibility}}">
          <StackPanel>
            <Border Padding="11,9"
                    Background="{DynamicResource PetBubbleSubtleBrush}"
                    CornerRadius="6">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource PetBubbleMutedBrush}"
                           FontSize="9"
                           FontWeight="Bold"
                           Text="입력" />
                <TextBlock Margin="0,5,0,0"
                           AutomationProperties.Name="사용자 입력 메시지"
                           Foreground="{DynamicResource PetBubbleTextBrush}"
                           FontSize="12"
                           LineHeight="17"
                           Text="{Binding InputBubbleText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Margin="0,8,0,0"
                    Padding="11,9"
                    Background="Transparent"
                    BorderBrush="{DynamicResource PetBubbleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PetBubbleAccentBrush}"
                        CornerRadius="999" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Foreground="{DynamicResource PetBubbleAccentBrush}"
                             FontSize="9"
                             FontWeight="Bold"
                             Text="출력" />
                  <TextBlock Margin="0,5,0,0"
                             AutomationProperties.Name="AI 출력 메시지"
                             Foreground="{DynamicResource PetBubbleTextBrush}"
                             FontSize="12"
                             FontWeight="Medium"
                             LineHeight="17"
                             Text="{Binding OutputBubbleText}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,11,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Border Padding="8,4"
                    Background="{DynamicResource PetBubbleSubtleBrush}"
                    CornerRadius="4">
              <TextBlock Foreground="{DynamicResource PetBubbleAccentBrush}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Text="{Binding InputTokenText}" />
            </Border>
            <Border Margin="6,0,0,0"
                    Padding="8,4"
                    Background="{DynamicResource PetBubbleSubtleBrush}"
                    CornerRadius="4">
              <TextBlock Foreground="{DynamicResource PetBubbleTextBrush}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Text="{Binding OutputTokenText}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Visibility="{Binding HasRunningCarousel, Converter={StaticResource BooleanToVisibility}}">
            <Button AutomationProperties.Name="이전 동시 세션"
                    Command="{Binding PreviousCommand}"
                    Content="‹"
                    Style="{StaticResource PetCarouselButtonStyle}"
                    ToolTip="이전 세션" />
            <TextBlock MinWidth="30"
                       Margin="4,0"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding AccessiblePositionText}"
                       Foreground="{DynamicResource PetBubbleTextBrush}"
                       FontSize="10"
                       Text="{Binding CounterText}"
                       TextAlignment="Center" />
            <Button AutomationProperties.Name="다음 동시 세션"
                    Command="{Binding NextCommand}"
                    Content="›"
                    Style="{StaticResource PetCarouselButtonStyle}"
                    ToolTip="다음 세션" />
          </StackPanel>
        </Grid>

        <Thumb Grid.RowSpan="4"
               Width="18"
               Height="18"
               Margin="0"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               AutomationProperties.Name="채팅창 크기 조절"
               Background="Transparent"
               Cursor="SizeNWSE"
               DragDelta="OnBubbleResize">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <Path Margin="4"
                      Data="M 3,10 L 10,3 M 7,10 L 10,7"
                      Stroke="{DynamicResource PetBubbleMutedBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Grid>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>

    <Button x:Name="AvatarButton"
            Grid.Column="2"
            Width="166"
            Height="184"
            Margin="0,0,4,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.HelpText="왼쪽 클릭으로 대시보드를 열고 오른쪽 클릭으로 메뉴를 엽니다"
            AutomationProperties.Name="{Binding AccessibilityDescription}"
            Style="{StaticResource TransparentPetButtonStyle}"
            PreviewMouseLeftButtonDown="OnAvatarMouseLeftButtonDown"
            PreviewMouseMove="OnAvatarMouseMove"
            PreviewMouseLeftButtonUp="OnAvatarMouseLeftButtonUp"
            PreviewMouseRightButtonUp="OnAvatarRightClick"
            ToolTip="amon 대시보드 열기">
      <Grid x:Name="AvatarVisual" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="AvatarScale" ScaleX="1" ScaleY="1" />
            <RotateTransform x:Name="AvatarRotate" Angle="0" />
            <TranslateTransform x:Name="AvatarTranslate" X="0" Y="0" />
          </TransformGroup>
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="ActivityStates">
            <VisualState x:Name="Still">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="X" To="0" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Idle">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" From="0" To="-2" Duration="0:0:0.9" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Running">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" From="-2" To="-10" Duration="0:0:0.21" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-3.5" To="3.5" Duration="0:0:0.21" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.025" Duration="0:0:0.21" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.025" Duration="0:0:0.21" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="NeedsInput">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="X" From="-2" To="2" Duration="0:0:0.275" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-6" To="6" Duration="0:0:0.275" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Ready">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" From="0" To="-9" Duration="0:0:0.35" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-5" To="5" Duration="0:0:0.35" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Blocked">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:0.12" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-2" To="2" Duration="0:0:0.12" />
              </Storyboard>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Ellipse Width="126"
                 Height="126"
                 VerticalAlignment="Bottom"
                 Fill="{DynamicResource PetBubbleSubtleBrush}"
                 Stroke="{DynamicResource PetBubbleAccentBrush}"
                 StrokeThickness="2"
                 Visibility="{Binding HasSprite, Converter={StaticResource InverseBooleanToVisibility}}" />
        <TextBlock Margin="0,0,0,27"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   FontFamily="Segoe UI Symbol"
                   FontSize="58"
                   Foreground="{DynamicResource PetBubbleTextBrush}"
                   Text="✦"
                   Visibility="{Binding HasSprite, Converter={StaticResource InverseBooleanToVisibility}}" />
        <Grid Width="158"
              Height="180"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Visibility="{Binding HasSprite, Converter={StaticResource BooleanToVisibility}}">
          <local:CodexPetSpriteControl SourcePath="{Binding SpritePath}"
                                       SpriteVersion="{Binding SpriteVersion}"
                                       SpriteRevision="{Binding SpriteRevision}"
                                       DragDirection="{Binding DragDirection}"
                                       Status="{Binding Current.Status}" />
        </Grid>
      </Grid>
    </Button>
  </Grid>
</Window>
