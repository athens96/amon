<Window x:Class="AMon.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AMon.App"
        Width="390"
        Height="178"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Topmost="True"
        WindowStyle="None">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="136" />
    </Grid.ColumnDefinitions>

    <Border x:Name="ActivityBubble"
            Padding="14"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding AccessibilityDescription}"
            Background="#F21F2029"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Foreground="{StaticResource AccentBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="{Binding Current.Provider}" />
          <TextBlock DockPanel.Dock="Right"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="11"
                     Text="{Binding Current.StatusText}" />
        </DockPanel>
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="{Binding Current.Title}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   AutomationProperties.Name="현재 입력"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="12"
                   Text="{Binding Current.InputText}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding ShowsCurrentTask, Converter={StaticResource BooleanToVisibility}}" />
        <TextBlock Grid.Row="3"
                   Margin="0,3,0,0"
                   AutomationProperties.Name="최근 출력"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Text="{Binding Current.OutputText}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding ShowsCurrentTask, Converter={StaticResource BooleanToVisibility}}" />

        <local:PetTokenBar Grid.Row="5"
                           Height="5"
                           Margin="0,9,0,0"
                           InputFraction="{Binding InputFraction}"
                           OutputFraction="{Binding OutputFraction}"
                           RemainderFraction="{Binding RemainderFraction}"
                           Visibility="{Binding HasTokenBreakdown, Converter={StaticResource BooleanToVisibility}}" />

        <Grid Grid.Row="6" Margin="0,7,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{StaticResource AccentBrush}"
                       FontSize="11"
                       Text="{Binding InputTokenText}" />
            <TextBlock Margin="9,0,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Text="{Binding OutputTokenText}" />
            <TextBlock Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Text="{Binding TotalTokenText}" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Visibility="{Binding HasRunningCarousel, Converter={StaticResource BooleanToVisibility}}">
            <Button Width="24"
                    Height="22"
                    Padding="0"
                    AutomationProperties.Name="이전 동시 세션"
                    Command="{Binding PreviousCommand}"
                    Content="‹"
                    ToolTip="이전 세션" />
            <TextBlock MinWidth="35"
                       Margin="5,0"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding AccessiblePositionText}"
                       FontSize="11"
                       Text="{Binding CounterText}"
                       TextAlignment="Center" />
            <Button Width="24"
                    Height="22"
                    Padding="0"
                    AutomationProperties.Name="다음 동시 세션"
                    Command="{Binding NextCommand}"
                    Content="›"
                    ToolTip="다음 세션" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Button x:Name="AvatarButton"
            Grid.Column="2"
            Width="128"
            Height="158"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.HelpText="왼쪽 클릭으로 대시보드를 열고 오른쪽 클릭으로 메뉴를 엽니다"
            AutomationProperties.Name="{Binding AccessibilityDescription}"
            Background="Transparent"
            BorderThickness="0"
            Click="OnAvatarClick"
            PreviewMouseRightButtonUp="OnAvatarRightClick"
            ToolTip="A-mon 대시보드 열기">
      <Grid x:Name="AvatarVisual"
            RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="AvatarScale" ScaleX="1" ScaleY="1" />
            <RotateTransform x:Name="AvatarRotate" Angle="0" />
            <TranslateTransform x:Name="AvatarTranslate" X="0" Y="0" />
          </TransformGroup>
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="ActivityStates">
            <VisualState x:Name="Still">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="X" To="0" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Idle">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" From="0" To="-2" Duration="0:0:0.9" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Running">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" From="-2" To="-10" Duration="0:0:0.21" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-3.5" To="3.5" Duration="0:0:0.21" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.025" Duration="0:0:0.21" />
                <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.025" Duration="0:0:0.21" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="NeedsInput">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="X" From="-2" To="2" Duration="0:0:0.275" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-6" To="6" Duration="0:0:0.275" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Ready">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="Y" From="0" To="-9" Duration="0:0:0.35" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-5" To="5" Duration="0:0:0.35" />
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Blocked">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="AvatarTranslate" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:0.12" />
                <DoubleAnimation Storyboard.TargetName="AvatarRotate" Storyboard.TargetProperty="Angle" From="-2" To="2" Duration="0:0:0.12" />
              </Storyboard>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Ellipse Width="116"
                 Height="116"
                 VerticalAlignment="Bottom"
                 Fill="#EE2A2C39"
                 Stroke="{StaticResource AccentBrush}"
                 StrokeThickness="2" />
        <TextBlock Margin="0,0,0,23"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   FontFamily="Segoe UI Symbol"
                   FontSize="54"
                   Foreground="{StaticResource TextBrush}"
                   Text="✦" />
        <Border Width="72"
                Margin="0,0,0,5"
                Padding="5,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{StaticResource AccentBrush}"
                CornerRadius="8">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Text="{Binding Current.StatusText}" />
        </Border>
      </Grid>
    </Button>
  </Grid>
</Window>
