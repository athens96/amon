<Window x:Class="AMon.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AMon"
        Title="A-mon" Width="496" Height="540" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" Background="{StaticResource WindowBrush}"
        Topmost="True" FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <local:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <local:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="48" Height="26">
              <Border x:Name="Track" Background="{StaticResource LineBrush}" CornerRadius="13" />
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="6,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,6,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Visibility="{Binding SettingsVisible, Converter={StaticResource VisibleWhenFalse}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="16,0">
          <TextBlock Text="A-mon" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" ToolTip="새로고침">
              <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE72C;" />
            </Button>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,14">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,2,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="오늘 사용량" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding Today}" FontSize="32" FontWeight="Bold" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="전체 누적" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding AllTime}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,9,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="입력" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding Input}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="출력" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding Output}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="캐시" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding Cache}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
            </Grid>

            <TextBlock Text="프로바이더 한도" Style="{StaticResource SectionTitle}" Visibility="{Binding ProviderSnapshots.Count, Converter={StaticResource ResourceKey=CountVisibility}}" />
            <ItemsControl ItemsSource="{Binding ProviderSnapshots}" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,5">
                    <StackPanel>
                      <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Plan}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                      </Grid>
                      <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                      <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,12,0">
                              <Grid>
								<TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ResetText, Mode=OneWay}" /></TextBlock>
								<TextBlock Text="{Binding RemainingText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" />
                              </Grid>
                              <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="로컬 사용량" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,3">
                    <Grid>
                      <TextBlock Text="{Binding Name}" FontSize="12" />
					<TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"><Run Text="{Binding Today, Mode=OneWay}" /><Run Text="  /  " /><Run Text="{Binding Total, Mode=OneWay}" /></TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="최근 세션" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding RecentSessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="24">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" Visibility="{Binding Active, Converter={StaticResource VisibleWhenTrue}}" />
                      <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
					<TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"><Run Text="{Binding Provider, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" /></TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="0" Visibility="{Binding SettingsVisible, Converter={StaticResource VisibleWhenTrue}}">
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="66" /></Grid.RowDefinitions>
        <Grid Margin="16,0"><TextBlock Text="설정" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="변경 후 저장" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        <ScrollViewer Grid.Row="1" Padding="16,0,16,8" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="일반" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,7"><Grid><StackPanel><TextBlock Text="자동 업데이트" FontWeight="SemiBold" /><TextBlock Text="새 버전을 자동으로 설치합니다" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><CheckBox IsChecked="{Binding AutoUpdate}" Style="{StaticResource Toggle}" HorizontalAlignment="Right" /></Grid></Border>
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="세션 정보 공유" FontWeight="SemiBold" /><TextBlock Text="연결된 서버에 세션 요약을 전송합니다" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><CheckBox IsChecked="{Binding ShareSessions}" Style="{StaticResource Toggle}" HorizontalAlignment="Right" /></Grid></Border>
            <TextBlock Text="데이터 소스" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="로그 경로 자동 감지" FontWeight="SemiBold" /><TextBlock Text="Claude, Codex 등 기본 위치를 사용합니다" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><CheckBox IsChecked="{Binding AutomaticPaths}" Style="{StaticResource Toggle}" HorizontalAlignment="Right" /></Grid></Border>
            <TextBlock Text="서버 연결" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,7"><TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource MutedBrush}" /></Border>
            <Button Command="{Binding OpenConfigCommand}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Padding="12" Cursor="Hand" HorizontalContentAlignment="Stretch">
              <Grid><TextBlock Text="고급 설정" FontWeight="SemiBold" /><TextBlock Text="서버 주소 · 개별 경로  ›" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="16,10,16,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button Command="{Binding ShowDashboardCommand}" Content="돌아가기" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" Margin="0,0,4,0" FontWeight="SemiBold" />
          <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}" Content="저장" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" FontWeight="SemiBold" />
        </Grid>
      </Grid>

      <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="8,8">
          <StackPanel>
            <Button Command="{Binding ShowDashboardCommand}" Style="{StaticResource IconButton}" ToolTip="대시보드"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" /></Button>
            <Button Style="{StaticResource IconButton}" ToolTip="세션" Margin="0,20,0,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" /></Button>
            <Button Command="{Binding ShowSettingsCommand}" Style="{StaticResource IconButton}" ToolTip="설정" Margin="0,20,0,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" /></Button>
          </StackPanel>
          <Button Command="{Binding ExitCommand}" Style="{StaticResource IconButton}" ToolTip="종료" VerticalAlignment="Bottom"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" /></Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
